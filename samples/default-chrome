					);
				}
			}
			SetupMenuButtons();

			function getScrollY() {
				return window.scrollY || window.pageYOffset;
			}

			function throttle(fn, threshold, scope) {
				threshold || (threshold = 250);
				var last, deferTimer;

				return function () {
					var context = scope || this;
					var now = +new Date, args = arguments;
					if (last && now < last + threshold) {
						// hold on to it
						clearTimeout(deferTimer);
						deferTimer = setTimeout(function () {
							last = now;
							fn.apply(context, args);
						}, threshold);
					} else {
						last = now;
						fn.apply(context, args);
					}
				};
			}

			function setupFloatingMenu() {
				const FLOAT_CLASS = 'chrome-header-top-row--floating';
				const topHeaderBar = document.querySelector('#chrome-header-top-row');
				function handleScroll() {
					if (getScrollY() <= 0) {
						topHeaderBar.classList.remove(FLOAT_CLASS);
					} else {
						topHeaderBar.classList.add(FLOAT_CLASS);
					}
				}

				// don't bind if no top nav bar
				if (topHeaderBar) {
					document.addEventListener('scroll', throttle(handleScroll, 60));
				}
			}
			setupFloatingMenu();
		}());

