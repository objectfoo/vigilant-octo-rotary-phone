				unHighlightChromeMenuItems: unHighlightChromeMenuItems,
				refreshMessagesIndicator: refreshMessagesIndicator,
				logChromeNavClick: logChromeNavClick,
				openKebabMenu: openKebabMenu,
				closeKebabMenu: closeKebabMenu,
				getItemLocation: getItemLocation,
				locations: locations,
				logNotificationOpened: logNotificationOpened
			};
		}());

