				if (!elementId) return;

				elementId.setAttribute(aria, message);
			}

			function hideNotificationsClass(className) {
				var elements = document.getElementsByClassName(className);
				if (!elements) return;

				for (var i = 0; i < elements.length; ++i) {
					elements[i].style.display = "none";
					if (elements[i].parentElement)
						elements[i].parentElement.removeAttribute('aria-label');
				}
			}

			function showNotificationsClassWithMessage(className, message) {
				var elements = document.getElementsByClassName(className);
				if (!elements) return;

				for (var i = 0; i < elements.length; ++i) {
					elements[i].style.display = "block";
					elements[i].innerHTML = message;
					if (elements[i].parentElement)
						elements[i].parentElement.setAttribute('aria-label', elements[i].id);
				}
			}

			// This is an arbitrary delay, only meant to allow other (presumably more important) requests to take place first
			window.setTimeout(refreshMessagesIndicator, 2500);

			function logAmplitudeEvent(eventType, eventProperties) {
				if (!window.amplitude) {
					return;
				}
				var amplitudeInstance = window.amplitude.getInstance();
				amplitudeInstance.logEvent(eventType, eventProperties);
			}

			function logChromeNavClick(navId) {
				if (navId === 'Coaching') {
					logAmplitudeEvent("Message Menu - Coach Connect Clicked", {});
				} else {
					logAmplitudeEvent("Chrome - Navigation - Click", { NavID: navId, language: getCurrentLanguage() });
				}
			}

			function logNotificationOpened() {
				logAmplitudeEvent("Message Menu - Envelope Clicked", {});

				let elements = document.getElementsByClassName("chrome-nav-berry-coaching");
				let isCoachConnectBerryVisible = false;
				for (let i = 0; i < elements.length; ++i)
					isCoachConnectBerryVisible = isCoachConnectBerryVisible || elements[i].style.display === "block";
				if (isCoachConnectBerryVisible) {
					logAmplitudeEvent("Message Menu - Coach Connect Unread Seen", {});
				}
			}

			function getCurrentLanguage() {
				if (window.multiLanguage && window.multiLanguage.supportsMultiLanguage && window.multiLanguage.currentRegion) {
					return window.multiLanguage.currentRegion;
				}

				return "en";
			}

			function openKebabMenu() {
				var kebabMenu = getElement("#kebab-menu");
				kebabMenu.classList.add("chrome-menu--open");
			}

			function closeKebabMenu() {
				var kebabMenu = getElement("#kebab-menu");
				kebabMenu.classList.remove("chrome-menu--open");
			}

			var locations = Object.freeze({ NONE: 0, SEGMENT: 1, KEBAB: 2 });

			function getItemLocation(name) {
				var kebabMenu = document.getElementById("kebab-menu");
				var segmentMenu = document.getElementById("segment-menu");

				if (kebabMenu.querySelector(".chrome-nav-" + name.toLowerCase())) {
					return locations.KEBAB;
				}

				if (segmentMenu.querySelector(".chrome-nav-" + name.toLowerCase())) {
					return locations.SEGMENT;
				}

				return location.NONE;
			}

			return {
				version: 2,
				selectMenuItem: function (name) {
					selectChromeMenuItem("chrome-nav-" + name.toLowerCase());
