			function SetupMenuButtons() {
				const messagesToggle = document.querySelector("#notification-menu-toggle");
				const kebabToggle = document.querySelector("#kebab-menu-toggle");
				let menuButtonOpenEvents;

				if (messagesToggle !== null && kebabToggle !== null) {
					menuButtonOpenEvents = new MenuButtonOpenEvents();
				}

				if (messagesToggle !== null) {
					const notificationMenu = document.querySelector("#notification-menu");
					new MenuButton({
						name: "notificationMenu",
