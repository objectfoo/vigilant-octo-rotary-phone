		(function () {
			const MENU_FOCUS_CLASS = "focus-link";
			const MENU_FOCUS_SELECTOR = "." + MENU_FOCUS_CLASS;
			const MENU_LIST_ITEM_SELECTOR = "a";
			const LIST_ITEM_SELECTOR = "li[role=none]";

			/**
			 * Pass open event between menu buttons
			 * @class
			 */
			class MenuButtonOpenEvents {
				constructor() {
					this.subscribers = [];
				}

				/** @param {() => void} subscriberFn */
				subscribe = (subscriberFn) => { this.subscribers.push(subscriberFn); };

				/** @param {string} menuName */
				open = (menuName) => { this.subscribers.forEach((sub) => { sub.call(null, menuName); }); };
			}

			class MenuButton {
				/** Behavior for chrome MenuButtons
				 * @param {Object} config
				 * @param {string} config.name
				 * @param {HTMLElement} config.buttonNode
				 * @param {HTMLElement} config.menuNode
				 * @param {() => void} config.openMenu
				 * @param {() => void} config.closeMenu
				 * @param {MenuButtonOpenEvents|undefined} config.menuButtonOpenEvents
				 * @requires window.chromeOne
				 */
				constructor(config) {
					const { name, buttonNode, menuNode, openMenu, closeMenu, menuButtonOpenEvents } = config;
					this.MenuName = name;
					this.OpenMenu = openMenu;
					this.CloseMenu = closeMenu;
					this.ButtonNode = buttonNode;
					this.MenuNode = menuNode;
					this.ClickAwayListener = null;
					this.MenuButtonOpenEvents = menuButtonOpenEvents
					this.Setup();
				}

				Setup() {
					this.ButtonNode.setAttribute("aria-expanded", "false");
					this.ButtonNode.addEventListener("click", this.OnToggleClick);
					this.MenuNode.addEventListener("keydown", this.OnMenuKeydown);
					if (this.MenuButtonOpenEvents !== undefined) {
						this.SubscribeToMenuButtonOpenEvents();
					}
				}

				SubscribeToMenuButtonOpenEvents = () => {
					this.MenuButtonOpenEvents.subscribe((owner) => {
						if (this.MenuName !== owner && this.IsMenuOpen()) {
							this.ToggleMenu()
						}
					});
				};

				OnToggleClick = (e) => {
					e.stopPropagation();
					this.ToggleMenu();
				};

				OnMenuKeydown = (e) => {
					let stopEvent = false;
					const key = e.key;
					if (e.ctrlKey || e.altKey || e.metaKey) {
						return;
					}

					switch (key) {
						case "Up":
						case "ArrowUp":
							this.FocusSiblingMenuItem("previousLink");
							stopEvent = true;
							break;
						case "Down":
						case "ArrowDown":
							this.FocusSiblingMenuItem("nextLink");
							stopEvent = true;
							break;
						case "Tab":
						case "Escape":
							this.ToggleMenu();
							break;
					}

					if (stopEvent) {
						e.stopPropagation();
						e.preventDefault();
					}
				};

				IsMenuOpen = () => this.MenuNode.classList.contains("chrome-menu--open");

				PublishOpen = () => {
					if (this.MenuButtonOpenEvents !== undefined) {
						this.MenuButtonOpenEvents.open(this.MenuName);
					}
				};

				ToggleMenu = () => {
					if (this.IsMenuOpen()) {
						document.body.removeEventListener("click", this.OnBodyClick);
						this.ButtonNode.setAttribute("aria-expanded", "false");
						this.CloseMenu();
					} else {
						this.OpenMenu();
						this.FocusNavItem(this.MenuNode.querySelector("[aria-current=true]"));
						this.PublishOpen();
						this.ButtonNode.setAttribute("aria-expanded", "true");
						document.body.addEventListener("click", this.OnBodyClick);
					}
				};

				OnBodyClick = (e) => {
					if (!this.MenuNode.contains(e.target)) {
						this.ToggleMenu();
					}
				};

				/** @param {HTMLElement|null} selected */
				FocusNavItem = (selected) => {
					const focusLink = selected !== null ? selected : this.MenuNode.querySelector(MENU_LIST_ITEM_SELECTOR);
