					currentFocus?.classList.remove(MENU_FOCUS_CLASS);
					focusLink.focus();
					focusLink.classList.add(MENU_FOCUS_CLASS);
				};

				/** @param {"previousLink"|"nextLink"} direction */
				FocusSiblingMenuItem = (direction) => {
					const current = this.MenuNode.querySelector(MENU_FOCUS_SELECTOR);
					const li = current.closest(LIST_ITEM_SELECTOR);
					const targetLi = li[direction === "previousLink" ? "previousElementSibling" : "nextElementSibling"];
