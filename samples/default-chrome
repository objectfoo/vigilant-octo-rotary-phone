			function refreshMessagesIndicator() {
				var notificationBerryElements = document.querySelectorAll(".chrome-nav-messages-berry, .chrome-nav-berry-messages, .chrome-nav-berry-coaching");
				if (notificationBerryElements.length === 0) return;

				refreshNotificationIndicators();
			}

			async function refreshNotificationIndicators() {
				hideNotificationsClass("chrome-nav-messages-berry");
				hideNotificationsClass("chrome-nav-berry-messages");
				hideNotificationsClass("chrome-nav-berry-coaching");

				let secureMessageRes = await fetch('/Messaging/MessageCenter/Api/UnreadMessageCount').then(response => response.json());
				postToMobileApp('unreadMessageCount', String(secureMessageRes.UnreadMessageCount));

				if (secureMessageRes.UnreadMessageCount > 0) {
					showNotificationsClassWithMessage("chrome-nav-berry-messages", secureMessageRes.UnreadMessageCount + ' new');
					setAriaLabelForMessages('chrome-nav-Messages', 'aria-label', `you have ${secureMessageRes.UnreadMessageCount} unread secure messages`);
				}

				let coachConnectRes = await fetch('/HealthCoaching/Chrome/Connect/GetUnreadMessagesCount').then(response => response.json());
				postToMobileApp('unreadCoachConnectMessageCount', String(coachConnectRes.messageCount));

				if (coachConnectRes.messageCount > 0) {
					showNotificationsClassWithMessage("chrome-nav-berry-coaching", coachConnectRes.messageCount + ' new');
					setAriaLabelForMessages('chrome-nav-Coach Connect', 'aria-label', `you have ${coachConnectRes.messageCount} unread Coach Connect messages`);
				}

				let totalCount = secureMessageRes.UnreadMessageCount + coachConnectRes.messageCount;
				if (totalCount > 0) {
					showNotificationsClassWithMessage("chrome-nav-messages-berry", totalCount);
					setAriaLabelForMessages('notification-menu-toggle', 'aria-label', `you have ${totalCount} unread messages`);
				}
